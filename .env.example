# ==============================================================================
# AURA PRIME ESTATES - ENVIRONMENT CONFIGURATION
# ==============================================================================

# GEMINI_API_KEY: Required for Gemini AI property chatbot and intelligent property matching.
# Automatically provided in Google AI Studio or set via user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION (HYBRID MODE):
# When supplied, the platform automatically routes properties, leads, site visits,
# and settings directly to your Supabase PostgreSQL instance.
# When absent, the application gracefully operates with its built-in resilient database engine.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
